# Port the web UI/API listens on
PORT=3000

# Root directory to scan for docker-compose projects (one level deep).
# On the production host this is the /docker bind mount described in spec.md.
# Override locally if you're developing off-host (e.g. a scratch folder with
# a couple of fake projects under it).
PROJECTS_ROOT=/docker

# How often the dashboard polls local git/container status, in ms.
# This never triggers a network fetch -- see spec.md.
POLL_INTERVAL_MS=15000

# How long an operation (pull/rebuild/checkout/fetch) may run before it's
# killed and reported as failed, in ms.
OPERATION_TIMEOUT_MS=600000

# Max number of commits returned by the rollback history dropdown.
HISTORY_LIMIT=20

# How often an open dashboard asks the server to `git fetch` the manager's
# own repo to look for updates, in ms. Only runs while a tab is visible.
SELF_CHECK_INTERVAL_MS=300000

# Where dismissed-project state is kept. Defaults to a file inside
# PROJECTS_ROOT so it survives rebuilds and is shared across devices.
# STATE_FILE=/docker/.docker-local-manager.json
